{
  "name": "solitary-coding-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @solitary-coding/shared build && pnpm --filter @solitary-coding/server build && pnpm --filter @solitary-coding/client build && pnpm --filter solitary-coding build",
    "dev": "pnpm -r dev",
    "clean": "rm -rf packages/*/dist",
    "type-check": "tsc --noEmit",
    "type-check:client": "tsc --noEmit -p packages/client/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3"
    ]
  }
}
