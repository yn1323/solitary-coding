{
  "name": "@solitary-coding/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runner/claude": {
      "types": "./dist/runner/claude.d.ts",
      "import": "./dist/runner/claude.js"
    },
    "./port": {
      "types": "./dist/port.d.ts",
      "import": "./dist/port.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/runner/claude.ts src/port.ts --format esm --dts",
    "dev": "tsup src/index.ts src/runner/claude.ts src/port.ts --format esm --dts --watch"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "^0.4.0",
    "@solitary-coding/shared": "*",
    "better-sqlite3": "^11.0.0",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0"
  }
}
