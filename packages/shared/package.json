{
  "name": "@solitary-coding/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./db/schema": {
      "types": "./dist/db/schema.d.ts",
      "import": "./dist/db/schema.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/db/schema.ts --format esm --dts",
    "dev": "tsup src/index.ts src/db/schema.ts --format esm --dts --watch"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.0"
  }
}
